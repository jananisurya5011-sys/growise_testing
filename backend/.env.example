# GroWise Backend Environment Configuration Template
# Copy this file to .env and fill in the values

# Google Gemini AI API Key (Required for /api/crop-doctor, /api/cultivation, /api/chat)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenWeatherMap API Key (Optional - backend provides fallback mock if omitted)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Flask App Secret Key
SECRET_KEY=growise_super_secure_secret_key

# Backend Port
PORT=5000
